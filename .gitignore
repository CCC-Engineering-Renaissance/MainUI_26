# Build directories
build/
build-linux/
build-appimage/
build-appimage-portable/
cmake-build-*/

# AppImage packaging
packaging/.cache/
*.AppImage

# Bundled relocatable Python runtime (large; staged for packaging, not tracked)
python/

# Qt Creator user files
*.user
*.user.*

# COLMAP workspace data (generated at runtime)
workspace/
**/database.db
**/sparse/
**/dense/
**/fused.ply
**/meshed-*.ply

# Bundled tools (large binaries, platform-specific)
tools/

# Compiled output
*.o
*.a
*.so
*.dylib
*.dll
*.exe
MainUI_26
MainUI_26.app/

# Qt MOC/UIC/RCC generated files
moc_*.cpp
ui_*.h
qrc_*.cpp

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
Makefile

# OS-specific
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
*.swp

# Runtime logs written by child processes
*.log

# Embedded COLMAP source (use as submodule or keep separate)
colmap/
